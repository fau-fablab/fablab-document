\usepackage[inner=2.5cm,outer=1.5cm,top=2cm,bottom=3.5cm]{geometry} %Seitenränder, innen (Bindung) breiter, wechselt bei geraden/ungeraden Seiten

\usepackage{hyperref} % Hyperlinks im PDF, möglichst spät laden
\hypersetup{colorlinks=false,urlbordercolor=blue,linkbordercolor=red} % Link-Umrandung im PDF-Viewer (nicht beim Ausdrucken)

\definecolor{fablab}{RGB}{20,51,105}
                                %Fablab-Blau

\setlength{\headheight}{56pt} % Wenn dies nicht groß genug gesetzt ist, ist die Fußzeile der ersten Seite verschoben und es erscheint die Warnung "headheight too small"
\pagestyle{fancy}               %Fancy Seitenstil verwenden
\fancyhf{}                      %alle Kopf- und Fußzeilenfelder bereinigen

%
%Kopfzeile Rechts 
%
% Logo aus dem Untermodul logo (fau-fablab/logo). Fehlt es, weil ohne
% --recursive geklont wurde, steht statt des Logos der Name als Text.
\newcommand{\FabLabLogoDatei}{\basedir/logo/Logo/Logo-FAU-bunt.pdf}
\newcommand{\FabLabLogo}[1][1cm]{%
        \IfFileExists{\FabLabLogoDatei}%
                {\includegraphics[height=#1]{\FabLabLogoDatei}}%
                {\textbf{FAU FabLab}}}
\IfFileExists{\FabLabLogoDatei}{}{%
        \ClassWarningNoLine{fablab-document}{Logo fehlt: Untermodul fablab-document/logo
        nicht geladen, bitte 'git submodule update --init --recursive'}}
\fancyhead[R]{
        \begin{tikzpicture}
                \node at (\textwidth,0.5cm)[anchor=east, inner xsep=0pt] {\FabLabLogo[1cm]};%
                                %Logo einfügen
                \path[color=fablab] (0, 0) edge (\textwidth, 0);
                                %Trennlinie einfügen
                \node at (0cm, 0.5cm)[anchor=west] {\LARGE \@title};
        \end{tikzpicture}
}
% Fußzeile links Autor, Mitte Seitenzahl, rechts Version/Datum. Symmetrisch
% belassen (nicht nach geraden/ungeraden Seiten gespiegelt), da Dokumente die
% Felder mit \fancyfoot[L], [C], [R] überschreiben.
\fancyfoot[L]{\@author}
\colorlet{FLgrau}{black!45} % englische Übersetzungen in hellem Grau
\fancyfoot[C]{Seite \thepage~von~\pageref*{LastPage}{\color{FLgrau}\ \textperiodcentered\ Page \thepage~of~\pageref*{LastPage}}}
% Versionsnummer: "make VERSION=2026.09.29" erzeugt version.tex (z.B. in der
% GitHub Action). Ohne version.tex steht wie bisher das Datum in der Fußzeile.
% Dokumente, die \Version selbst definieren, behalten ihre Definition.
\AtBeginDocument{%
        \@ifundefined{Version}{\InputIfFileExists{version}{}{}}{}%
}
\fancyfoot[R]{
        \@ifundefined{Version}{\today}{Version \Version}
}
\renewcommand{\headrulewidth}{0pt}
                                %Standardlinie entfernen
\renewcommand{\footrulewidth}{0.4pt}
                                %Horizontale Linie in der Fußzeile
\renewcommand{\footrule}{{\color{fablab}\hrule width\headwidth height\footrulewidth}%
        \ifFLLizenzzeile\vbox to 0pt{\vskip 22pt\hbox to\headwidth{\hss\FLLizenzzeile\hss}\vss}\fi}

% Lizenzzeile klein unter der Fußzeile, damit auch einzeln kopierte Seiten Quelle
% und Lizenz tragen. Sie hängt an der Linie (\footrule) statt an \fancyfoot[C],
% weil viele Dokumente die Felder der Fußzeile überschreiben.
% Abschalten mit \FLLizenzzeilefalse, Repository setzen mit \repo{name}
% (Standard: \Repository aus revision.tex, erzeugt von make).
\newif\ifFLLizenzzeile
\FLLizenzzeiletrue
\newcommand{\FLRepo}{}
\newcommand{\repo}[1]{\renewcommand{\FLRepo}{#1}}
\AtBeginDocument{\ifx\FLRepo\@empty\@ifundefined{Repository}{}{\let\FLRepo\Repository}\fi}
\newcommand{\FLLizenzzeile}{{\sffamily\tiny\color{black!60}%
        \IfFileExists{\basedir/cc-by-sa.pdf}{\raisebox{-0.35ex}{\includegraphics[height=2.2ex]{\basedir/cc-by-sa.pdf}}\enspace}{}%
        \copyright\ FAU FabLab et al.\ \textperiodcentered\ Lizenz / License CC BY-SA 3.0%
        \ifx\FLRepo\@empty\else\ \textperiodcentered\ github.com/fau-fablab/\FLRepo\fi
        \ifFLRevision\ \textperiodcentered\ Rev.~\Revision\fi}}
% Fußzeile etwas höher, damit die Lizenzzeile im druckbaren Bereich liegt
\setlength{\footskip}{30pt}

% Keine Hurenkinder und Schusterjungen
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\raggedbottom % Seiten nicht strecken, wenn dadurch Zeilen auf die nächste Seite rutschen

% Abschnitte mit "Betreuer" im Titel beginnen automatisch auf einer neuen Seite.
% Für Duplexdruck mit Beginn auf einer rechten Seite im Dokument setzen:
%   \renewcommand{\FLBetreuerUmbruch}{\cleardoublepage}
\newcommand{\FLBetreuerUmbruch}{\clearpage}
\let\FL@section\section
\renewcommand{\section}{\@ifstar{\FL@section*}{\@dblarg\FL@sectionopt}}
\def\FL@sectionopt[#1]#2{%
        \IfSubStr{\detokenize{#2}}{Betreuer}{\FLBetreuerUmbruch}{}%
        \FL@section[#1]{#2}}
% explizite Form, falls der Titel nicht "Betreuer" enthält
\newcommand{\betreuerkapitel}[1]{\FLBetreuerUmbruch\FL@section{#1}}

\setlength{\voffset}{-0.3cm}    %Kopf ein wenig nach oben verschieben
% \renewcommand{\textheight}{23cm}%Textbereich vergrößern
\renewcommand{\familydefault}{\rmdefault}
                                %Serifenschrift (Libertinus)

% Neuer Befehl \subscript (Text tiefgestellt) von http://anthony.liekens.net/index.php/LaTeX/SubscriptAndSuperscriptInTextMode
\newcommand{\subscript}[1]{\ensuremath{_{\textnormal{\small{#1}}}}}
\newcommand{\zitat}[1]{\begin{quote}\textit{#1}\end{quote}}

\newcommand{\titletext}[1]{
  \begin{center}
   \vspace*{1cm} 
   \fontsize{36pt}{36pt} \selectfont \textbf{#1} \\
   \vspace{0.5cm}
  \end{center}
}
\renewcommand{\maketitle}{
  \titletext{\@title}
}

